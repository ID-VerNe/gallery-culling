{
  "name": "gallery-culling",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "e2e:unit": "vitest run",
    "e2e:rust": "cd src-tauri && cargo test --lib",
    "e2e:app": "node e2e/run.mjs",
    "e2e:inapp": "node e2e/run-inapp.mjs",
    "e2e:render": "node e2e/run-inapp.mjs --scenario=render-export",
    "e2e:preset": "node e2e/run-inapp.mjs --scenario=lumen-preset",
    "e2e": "npm run e2e:unit && npm run e2e:rust && npm run e2e:render"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.2",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-dialog": "~2.7.3",
    "@tauri-apps/plugin-fs": "~2.5.2",
    "@tauri-apps/plugin-opener": "~2.5.5",
    "@tauri-apps/plugin-os": "^2.2.0",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
