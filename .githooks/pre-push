#!/bin/sh
# 推送前跑 static 分片（issue #6）：清单一致性 + fmt 基线 + tsc。
#
# 为什么只跑 static：全量（vitest 约 60s、cargo test 冷编 10 分钟）不适合每次推送；
# static 是「最便宜、最先红」的一档，挡得住绝大多数低级错误。全量留给 `npm run gates`
# 与 CI。
#
# 逃生口：SKIP_GATES=1 git push（会留痕），或 worktree 里没装依赖时自动跳过（会警告）。
# 此外每个被推送的 sha 还会做一次 parity（issue #8）：在被推送 sha 的干净检出里复跑同一份清单，
# SKIP_PARITY=1 可跳过并留痕。
# 纯删除引用（issue #191）：本次推送所有本地 sha 都是全零时，没有新对象需要验，直接跳过
# static + parity 并打印一行可见理由；只要有一行是非删除更新，就照下面的流程跑。
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if [ "$SKIP_GATES" = "1" ]; then
  echo "pre-push: SKIP_GATES=1，跳过 static 门禁（$(date -u '+%Y-%m-%dT%H:%M:%SZ')）" >&2
  exit 0
fi

# 纯删除判定（issue #191）：git 把「本地引用 本地 sha 远端引用 远端 sha」逐行喂给 stdin，
# 删除引用时本地 sha 是 40 个 0。整批全是删除就没有新对象需要验，跳过 static + parity，
# 不再为删一个分支白跑一遍最便宜的一档。判定只看 local_sha 是否全零，不推断「是否追上远端」。
zero_sha=0000000000000000000000000000000000000000
ref_count=0
delete_count=0
while read -r local_ref local_sha remote_ref remote_sha; do
  ref_count=$((ref_count + 1))
  if [ "$local_sha" = "$zero_sha" ]; then
    delete_count=$((delete_count + 1))
  fi
done
if [ "$ref_count" -gt 0 ] && [ "$delete_count" -eq "$ref_count" ]; then
  echo "pre-push: 本次推送只删除引用（$delete_count 个），跳过 static + parity（$(date -u '+%Y-%m-%dT%H:%M:%SZ')）" >&2
  exit 0
fi

# worktree 里没有 node_modules（被 gitignore），tsc 跑不起来。与其红得莫名其妙，
# 不如说清「这一档被跳过了」——静默跳过才是真危险。
if [ ! -x node_modules/.bin/tsc ] && [ ! -f node_modules/.bin/tsc ]; then
  {
    echo "pre-push: 警告——当前目录没有 node_modules，static 门禁被跳过。"
    echo "  修法：在本 worktree 里 npm ci，或到主工作区推送。"
    echo "  这不是绿：tsc 与清单校验都没有跑过。"
  } >&2
  exit 0
fi

node scripts/run-gates.mjs ci --shard static --fail-fast
static_rc=$?
if [ "$static_rc" -ne 0 ]; then
  echo "pre-push: static 分片未通过，parity 不再执行（先在当前检修复，再看干净检出）" >&2
  exit "$static_rc"
fi

# parity（issue #8）：把「本地绿」挪到被推送 sha 的干净检出里复跑，证明它不只在本机成立。
# 为什么放在 static 之后：干净检出里没装依赖时它需要 npm ci，比 static 更贵；先让最便宜的
# 一档挡掉低级错误。为什么只跑 static 分片：cargo 冷编 10 分钟不适合每次推送，全量留给 CI。
if [ "$SKIP_PARITY" = "1" ]; then
  echo "pre-push: SKIP_PARITY=1，跳过 CI 等价复跑（$(date -u '+%Y-%m-%dT%H:%M:%SZ')）" >&2
  exit 0
fi

parity_rc=0
# 逐 sha 复跑：`origin/master..HEAD` 覆盖本分支上所有尚未进 master 的提交。
# 注意别写 `git rev-list --remotes=origin..HEAD`——`--remotes` 的值是按**引用名**做 glob 的，
# 后面再跟 `..` 会被当成引用名的一部分，静默返回空集，整个循环一次都不跑（等于 parity 从未生效）。
for sha in $(git rev-list origin/master..HEAD); do
  node scripts/check-pr-parity.mjs --ref "$sha" --shard static || parity_rc=$?
  [ "$parity_rc" -ne 0 ] && break
done

if [ "$parity_rc" -eq 2 ]; then
  {
    echo "pre-push: parity 环境问题（退出 2），没有完成 CI 等价复跑——这不是绿。"
    echo "  修法：确认 git 历史完整（git fetch origin master），或 SKIP_PARITY=1 git push（会留痕）。"
  } >&2
fi
exit "$parity_rc"
